{
  "name": "DriveNow - Dano reportado",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dano-reportado",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "drivenow-dano-reportado"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8069/json/2/fleet.vehicle.log.services/create",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Odoo-Database",
              "value": "drivenow"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"vals_list\":[{\"vehicle_id\": {{ $json.body.viaturaId }}, \"service_type_id\": {{ $json.body.tipoDanoId }}, \"amount\": {{ $json.body.custo }}, \"description\": {{ JSON.stringify($json.body.descricao || \"\") }}, \"state\": \"new\"}]}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "resposta"
            }
          }
        }
      },
      "name": "Registar dano no Odoo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"odooId\": {{ JSON.parse($json.resposta)[0] }} }",
        "options": {}
      },
      "name": "Responder ao backend",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Registar dano no Odoo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Registar dano no Odoo": {
      "main": [
        [
          {
            "node": "Responder ao backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}