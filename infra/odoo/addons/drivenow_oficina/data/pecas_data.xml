<?xml version="1.0" encoding="utf-8"?>
<!-- As 11 peças do armazém da oficina, com fornecedor, preço de compra e regra de mínimo e máximo.
     Gerado a partir da tabela "Peças em stock" do documento "Oficina, revisões e peças". -->
<odoo>
    <data noupdate="1">

        <!-- Pneu: mínimo 8, máximo 16 -->
        <record id="peca_pneu" model="product.product">
            <field name="name">Pneu</field>
            <field name="default_code">DN-PNEU</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="categ_id" ref="categoria_pecas"/>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="standard_price">85</field>
            <field name="list_price">0</field>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="True"/>
            <field name="description">&lt;p&gt;Usada em: Revisão; dano "pneu furado ou danificado"&lt;/p&gt;</field>
            <field name="route_ids" eval="[(4, ref('purchase_stock.route_warehouse0_buy'))]"/>
            <field name="seller_ids" eval="[(0, 0, {'partner_id': ref('fornecedor_pneus'), 'price': 85, 'delay': 5})]"/>
        </record>
        <record id="regra_pneu" model="stock.warehouse.orderpoint">
            <field name="product_id" ref="peca_pneu"/>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="product_min_qty">8</field>
            <field name="product_max_qty">16</field>
            <field name="trigger">auto</field>
            <field name="route_id" ref="purchase_stock.route_warehouse0_buy"/>
        </record>

