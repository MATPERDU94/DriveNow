                "exec": [
                  "const t = pm.response.headers.get('x-csrf-token');",
                  "pm.environment.set('csrf_token', t);",
                  "pm.test('CSRF token recebido', () => pm.expect(t).to.be.ok);"
                ]
              }
            }
