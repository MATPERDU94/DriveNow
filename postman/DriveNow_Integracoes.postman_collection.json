          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ligação ao SAP OK (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "sap-client",
                "value": "{{sap_client}}"
              }
            ],
            "url": {
              "raw": "{{sap_url}}sap/opu/odata/sap/MD_BUSINESSPARTNER_SRV/I_BusinessPartner?$select=BusinessPartner,FirstName,LastName,CreationDate&$top=5&$format=json",
              "host": [
                "{{sap_url}}sap"
              ],
              "path": [
                "opu",
                "odata",
                "sap",
                "MD_BUSINESSPARTNER_SRV",
                "I_BusinessPartner"
              ],
              "query": [
                {
                  "key": "$select",
                  "value": "BusinessPartner,FirstName,LastName,CreationDate"
                },
                {
                  "key": "$top",
                  "value": "5"
                },
                {
                  "key": "$format",
                  "value": "json"
                }
              ]
            },
            "description": "Teste de ligação: lê 5 Business Partners. Se der 200 OK, o utilizador, a password e o sap-client estão certos."
          },
          "response": []
        },
