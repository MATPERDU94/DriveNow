    {
      "name": "Moloni",
      "item": [
        {
          "name": "1. Login (obter access_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.environment.set('moloni_token', j.access_token);",
                  "pm.test('Token Moloni recebido', () => pm.expect(j.access_token).to.be.ok);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://api.moloni.pt/v1/grant/?grant_type=password&client_id={{moloni_client_id}}&client_secret={{moloni_client_secret}}&username={{moloni_username}}&password={{moloni_password}}",
              "protocol": "https",
              "host": [
                "api",
                "moloni",
                "pt"
              ],
              "path": [
                "v1",
                "grant",
                ""
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{moloni_client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{moloni_client_secret}}"
                },
                {
                  "key": "username",
                  "value": "{{moloni_username}}"
                },
                {
                  "key": "password",
                  "value": "{{moloni_password}}"
                }
              ]
            },
