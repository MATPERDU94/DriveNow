@startuml 1 - Registo do Cliente
title DriveNow - 1. Registo do cliente (v2)

|Cliente|
|App (SAP Build Apps)|
|Backend|
|n8n|
|SAP|
|Moloni|

|Cliente|
start
:Abrir a app e escolher "Criar conta";

repeat
  |Cliente|
  :Preencher dados (nome, email, NIF,\ntelemóvel, password), associar cartão\nou conta bancária e aceitar os termos;
  |App (SAP Build Apps)|
  :Enviar pedido de registo;
  |Backend|
  :Validar dados, NIF\ne meio de pagamento;
repeat while (Dados válidos?) is (não) not (sim)

|Backend|
:Guardar utilizador\n(password encriptada) e meio de pagamento\n(só os últimos 4 dígitos);
:Ativar conta e devolver token de sessão;

fork
  |App (SAP Build Apps)|
  :Guardar token e abrir o mapa;
  |Cliente|
  :Conta criada, pode reservar;
fork again
  |Backend|
  :Enviar evento "cliente registado"\n(webhook para o n8n);
  |n8n|
  fork
    |SAP|
    :Obter CSRF token;
    :Criar Business Partner\n(MD_BUSINESSPARTNER_SRV, draft);
  fork again
    |Moloni|
    :Procurar cliente pelo NIF;
    if (Já existe?) then (não)
      :Criar cliente\n(nome, NIF, email);
    else (sim)
    endif
  end fork
  |n8n|
  if (Ambos criados?) then (sim)
    :Enviar IDs do SAP e do Moloni\nao backend;
    |Backend|
    :Guardar IDs do SAP e do Moloni;
  else (não)
    |n8n|
    :Registar erro e tentar de novo\nmais tarde (ramo de erro);
  endif
end fork

stop

@enduml
