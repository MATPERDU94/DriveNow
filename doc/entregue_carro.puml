@startuml
title Devolução do Carro no Stand (Hub)

skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F7F5FF
  BorderColor #553C9A
}

|Cliente|
start
:Estaciona o carro no stand do hub;
:Abre a aplicação e seleciona\na reserva ativa;
:Clica em "Confirmar entrega do veículo";

|Sistema (Backend)|
:Confirma a entregue;
:Regista km finais e nível de combustível;
:Compara hora real de entrega\ncom hora de fim da reserva;

if (Entregou depois da hora de fim?) then (sim)
  :Calcula o atraso em escalões de 15 min\n(cada escalão iniciado conta):\n- até 15 min: 25% do preço/hora\n- até 30 min: 50% do preço/hora\n- até 45 min: 75% do preço/hora\n- até 1h: 100% do preço/hora\n- acima de 1h: continua a somar 25% por escalão;
  :Apresenta ao cliente o valor\nda taxa de atraso a pagar;

  |Cliente|
  repeat
    :Escolhe método de pagamento\ne paga a taxa de atraso;

    |Sistema (Backend)|
    :Processa pagamento da taxa;
  repeat while (Pagamento recusado?) is (sim) not (não)

  :Emite fatura/recibo da taxa de atraso;
else (não)
  :Sem custos adicionais;
endif

|Base de Dados|
:Inicia transação;
:Atualiza RESERVA\n(estado = "CONCLUÍDA", hora real de entrega);
:Atualiza o carro\n(km, combustível, hub atual,\nestado = "DISPONÍVEL");
:Remove o bloqueio do carro\n(se entregue antes do fim previsto,\nlibera o tempo restante);
:Regista pagamento da taxa de atraso\ne fatura final (se aplicável);
:Confirma transação (COMMIT);

|Sistema (Backend)|
:Liberta a caução ao cliente;

fork
  :Envia email ao cliente\n(resumo da devolução + fatura final);
fork again
  :Atualiza a Dashboard do cliente\n(reserva movida para o histórico);
fork again
  :Marca o carro como disponível\npara novas reservas no hub;
end fork

|Cliente|
:Recebe o email com o resumo\ne vê a reserva concluída na app;

if (Quer avaliar a experiência?) then (sim)
  :Submete avaliação do serviço;
else (não)
endif

stop

@enduml