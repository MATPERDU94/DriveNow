# Endereço do backend usado pelo proxy do Vite (npm run dev). Por omissão: http://localhost:8080
API_URL=http://localhost:8080

# Opcional: endereço completo da API quando o frontend é servido noutro sítio (ex.: túnel do Cloudflare).
# Vazio = usa o mesmo endereço do frontend (/api), que é o normal com o proxy.
VITE_API_URL=
