# Copiar para .env (cp .env.example .env) e preencher. O .env não vai para o Git.

# Odoo visto de dentro do contentor do backend
ODOO_URL=http://host.docker.internal:8069
# Nome da base de dados do Odoo (o que aparece em localhost:8069/web/database/manager)
ODOO_DB=drivenow
# Chave de API do Odoo: Preferências do utilizador → Segurança da conta → Nova chave de API
ODOO_API_KEY=

# Moloni: Configurações → Developers → Configuração de conta e API
MOLONI_CLIENT_ID=
MOLONI_CLIENT_SECRET=
MOLONI_USERNAME=
MOLONI_PASSWORD=
# id da empresa no Moloni (companies/getAll); sem valor usa a primeira da conta
MOLONI_COMPANY_ID=
# false = faturas em rascunho (testes); true = faturas finalizadas, com PDF
MOLONI_FECHAR_DOCUMENTOS=false
